#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
GITMACS_HOME="$(cd "$SELF_DIR/.." && pwd)"
export PATH="$SELF_DIR:$PATH"

ARGS=(-Q)
if [[ "${1:-}" == "--gui" ]]; then
  shift
else
  ARGS+=(-nw)
fi

cd "${1:-.}"

exec emacs "${ARGS[@]}" --load "$GITMACS_HOME/init.el"
